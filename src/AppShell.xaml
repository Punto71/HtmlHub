<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="HtmlHub.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:HtmlHub"
       FlyoutBehavior="Flyout"
       FlyoutWidth="300">

    <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="main" />

    <Shell.FlyoutContent>
        <Grid RowDefinitions="Auto,*,Auto" Padding="16,40,16,16" RowSpacing="12">
            <Label Text="Мои приложения" FontSize="22" FontAttributes="Bold" />

            <CollectionView x:Name="List" Grid.Row="1"
                            SelectionMode="Single"
                            SelectionChanged="OnSelected">
                <CollectionView.EmptyView>
                    <Label Text="Пока пусто. Добавьте HTML-файл." Opacity="0.6" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:HtmlApp">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                            <Label Text="{Binding Name}" VerticalOptions="Center" FontSize="16"
                                   LineBreakMode="TailTruncation" />
                            <Button Grid.Column="1" Text="✕" BackgroundColor="Transparent"
                                    TextColor="Red" WidthRequest="48" Clicked="OnDelete" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="2" Text="＋ Добавить HTML" Clicked="OnAdd" />
        </Grid>
    </Shell.FlyoutContent>
</Shell>
