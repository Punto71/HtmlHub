<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HtmlHub.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
			 SafeAreaEdges="None">
    <Grid>
        <WebView x:Name="Web" IsVisible="False" />

        <!-- Невидимая полоса у левого края: ловит свайп вправо и открывает меню -->
        <BoxView HorizontalOptions="Start" VerticalOptions="Fill"
                 WidthRequest="28" Opacity="0">
            <BoxView.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Right" Threshold="30"
                                        Swiped="OnEdgeSwiped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Label x:Name="Placeholder"
               Text="Откройте меню (☰ или свайп от левого края)&#10;и добавьте HTML-файл"
               HorizontalTextAlignment="Center"
               HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.6" />
    </Grid>
</ContentPage>
